{
  "name": "omni-verse-blog",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=20.0.0" },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev":       "next dev",
    "build":     "pnpm run prebuild && next build",
    "prebuild":  "tsx scripts/build-search-index.ts",
    "start":     "next start",
    "lint":      "next lint",
    "format":    "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test":      "vitest run",
    "test:watch":"vitest",
    "validate":  "pnpm run typecheck && pnpm run lint && pnpm run test",
    "migrate":   "tsx scripts/migrate-data.ts"
  },
  "dependencies": {
    "next":             "^15.0.0",
    "react":            "^19.0.0",
    "react-dom":        "^19.0.0",
    "next-mdx-remote":  "^5.0.0",
    "gray-matter":      "^4.0.3",
    "zod":              "^3.23.0",
    "fuse.js":          "^7.0.0",
    "rehype-pretty-code":"^0.14.0",
    "rehype-slug":      "^6.0.0",
    "shiki":            "^1.22.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@types/node":      "^20.0.0",
    "@types/react":     "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint":           "^9.0.0",
    "eslint-config-next":"^15.0.0",
    "prettier":         "^3.3.0",
    "tsx":              "^4.19.0",
    "typescript":       "^5.6.0",
    "vitest":           "^2.1.0"
  }
}
