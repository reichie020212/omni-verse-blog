{
  "name": "omni-verse-blog",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm run db:migrate && pnpm run prebuild && next build",
    "prebuild": "tsx scripts/build-cover-manifest.ts",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "validate": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "migrate": "tsx scripts/migrate-data.ts",
    "migrate:posts": "tsx --env-file=.env.local scripts/migrate-posts-to-db.ts",
    "new-post": "tsx scripts/new-post.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "auth:secret": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.2",
    "@libsql/client": "^0.17.3",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "fuse.js": "^7.0.0",
    "gray-matter": "^4.0.3",
    "next": "^15.0.0",
    "next-auth": "5.0.0-beta.31",
    "next-mdx-remote": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-pretty-code": "^0.14.0",
    "rehype-slug": "^6.0.0",
    "shiki": "^1.22.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@clack/prompts": "^1.2.0",
    "@eslint/eslintrc": "^3.0.0",
    "@playwright/test": "^1.59.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "prettier": "^3.3.0",
    "satori": "^0.26.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
