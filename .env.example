# Auth.js — generate with `pnpm auth:secret`
AUTH_SECRET=

# OAuth providers
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Database — local: file:local.db; production: libsql://<your-db>.turso.io
DATABASE_URL=file:local.db
# Required for Turso production; leave blank locally
DATABASE_AUTH_TOKEN=
